---
import BaseLayout from "@/layouts/BaseLayout.astro";
import SeriesCard from "@/components/SeriesCard.astro";
import { SERIES_IDS } from "@/config/series";
---

<BaseLayout
  meta={{
    title: "Series",
    description:
      "Longer topics broken into ordered parts: start at part one and each new part picks up where the last left off.",
    path: "/series/",
  }}
>
  <div class="max-w-wide mx-auto">
    <h1 class="text-display font-semibold">Series</h1>
    <p class="text-muted-foreground mt-3">
      Longer topics broken into parts. Each series builds on the one before it, so start at part one
      and read in order; new parts pick up where the last left off.
    </p>
    <ul class="mt-10 divide-y border-t pt-8">
      {SERIES_IDS.map((id) => <SeriesCard id={id} />)}
    </ul>
  </div>
</BaseLayout>

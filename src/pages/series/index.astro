---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { series, SERIES_IDS } from "@/config/series";
import { Image } from "astro:assets";
import { getSeriesHero, getSeriesPosts, seriesPath } from "@/lib/posts";
import { href } from "@/lib/url";

const entries = await Promise.all(
  SERIES_IDS.map(async (id) => ({
    id,
    ...series[id],
    count: (await getSeriesPosts(id)).length,
    hero: await getSeriesHero(id),
  })),
);
---

<BaseLayout meta={{ title: "Series", description: "Multi-part series.", path: "/series/" }}>
  <div class="max-w-wide mx-auto">
    <h1 class="text-display font-semibold">Series</h1>
    <p class="text-muted-foreground mt-3">Multi-part explorations, meant to be read in order.</p>
    <ul class="mt-10 divide-y border-t">
      {
        entries.map((s) => (
          <li class="grid-cols-thumb grid gap-x-4 py-6">
            <a href={href(seriesPath(s.id))} tabindex="-1" aria-hidden="true">
              <Image
                src={s.hero.src}
                alt={s.hero.alt}
                width={320}
                height={168}
                class="aspect-card w-full rounded-md border object-cover"
              />
            </a>
            <div>
              <h2 class="text-title font-semibold">
                <a href={href(seriesPath(s.id))} class="hover:text-primary no-underline">
                  {s.title}
                </a>
              </h2>
              <p class="text-muted-foreground mt-1">{s.description}</p>
              <p class="text-muted-foreground mt-2 text-sm">
                {s.count} {s.count === 1 ? "part" : "parts"}
              </p>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</BaseLayout>

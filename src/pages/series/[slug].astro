---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PostList from "@/components/PostList.astro";
import { series, SERIES_IDS, type SeriesId } from "@/config/series";
import { getSeriesPosts, seriesPath } from "@/lib/posts";

export function getStaticPaths() {
  return SERIES_IDS.map((slug) => ({ params: { slug } }));
}

const id = Astro.params.slug as SeriesId;
const info = series[id];
const posts = await getSeriesPosts(id);
---

<BaseLayout meta={{ title: info.title, description: info.description, path: seriesPath(id) }}>
  <h1 class="text-3xl font-bold tracking-tight">{info.title}</h1>
  <p class="text-muted-foreground mt-2">{info.description}</p>
  <div class="mt-8">
    {posts.length ? <PostList posts={posts} /> : <p class="text-muted-foreground">No posts yet.</p>}
  </div>
</BaseLayout>

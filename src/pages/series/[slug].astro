---
import BaseLayout from "@/layouts/BaseLayout.astro";
import DraftBadge from "@/components/DraftBadge.astro";
import { series, SERIES_IDS, type SeriesId } from "@/config/series";
import { Image } from "astro:assets";
import { getSeriesPosts, postPath, seriesPath } from "@/lib/posts";
import { formatDate, isoDate } from "@/lib/dates";
import { readingTime } from "@/lib/reading-time";
import { href } from "@/lib/url";

export function getStaticPaths() {
  return SERIES_IDS.map((slug) => ({ params: { slug } }));
}

const id = Astro.params.slug as SeriesId;
const info = series[id];
const posts = await getSeriesPosts(id);
---

<BaseLayout meta={{ title: info.title, description: info.description, path: seriesPath(id) }}>
  <div class="max-w-wide mx-auto">
    <p class="text-primary eyebrow">
      <a href={href("/series/")} class="hover:underline">All series</a>
    </p>
    <h1 class="text-display mt-2 font-semibold">{info.title}</h1>
    <p class="text-muted-foreground mt-4 text-lg">{info.description}</p>
    <p class="text-muted-foreground mt-2 text-sm">
      {posts.length === 1 ? "1 part" : `${posts.length} parts`}
    </p>
    <div class="mt-10 border-t pt-8">
      {
        posts.length ? (
          <ol class="divide-y">
            {posts.map((post, i) => (
              <li class="grid-cols-thumb grid gap-x-4 py-5 first:pt-0 last:pb-0">
                <a href={href(postPath(post))} tabindex="-1" aria-hidden="true">
                  <Image
                    src={post.data.hero.src}
                    alt={post.data.hero.alt}
                    width={320}
                    height={168}
                    class="aspect-card w-full rounded-md border object-cover"
                  />
                </a>
                <div>
                  <p class="text-primary eyebrow">Part {i + 1}</p>
                  <h2 class="text-title font-semibold">
                    <a href={href(postPath(post))} class="hover:text-primary no-underline">
                      {post.data.title}
                    </a>
                    {post.data.draft && <DraftBadge />}
                  </h2>
                  <p class="text-muted-foreground mt-1">{post.data.description}</p>
                  <p class="text-muted-foreground mt-2 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm">
                    <time datetime={isoDate(post.data.publishedAt)}>
                      {formatDate(post.data.publishedAt)}
                    </time>
                    <span>{readingTime(post.body ?? "")} min read</span>
                  </p>
                </div>
              </li>
            ))}
          </ol>
        ) : (
          <p class="text-muted-foreground">No posts yet.</p>
        )
      }
    </div>
  </div>
</BaseLayout>

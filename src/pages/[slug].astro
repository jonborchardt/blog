---
import { render } from "astro:content";
// KaTeX styles only on article pages (math never appears elsewhere).
import "katex/dist/katex.min.css";
import { Image } from "astro:assets";
import BaseLayout from "@/layouts/BaseLayout.astro";
import DraftBadge from "@/components/DraftBadge.astro";
import TableWrapper from "@/components/blog/TableWrapper.astro";
import PostTeaser from "@/components/PostTeaser.astro";
import PostToc from "@/components/PostToc.astro";
import TagList from "@/components/TagList.astro";
import { tags as tagRegistry } from "@/config/tags";
import {
  getPosts,
  getRelatedPost,
  getSeriesContext,
  postPath,
  postSlug,
  seriesPath,
} from "@/lib/posts";
import { readingTime, wordCount } from "@/lib/reading-time";
import { articleJsonLd } from "@/lib/seo";
import { href } from "@/lib/url";
import { effectiveUpdatedAt, formatDate, isoDate } from "@/lib/dates";
import { gitLastModified } from "@/lib/git-dates";

export async function getStaticPaths() {
  // getPosts() excludes drafts in production, so draft pages are never generated.
  return (await getPosts()).map((post) => ({ params: { slug: postSlug(post) }, props: { post } }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const path = postPath(post);
const ctx = await getSeriesContext(post);
const related = getRelatedPost(post, await getPosts());
const minutes = readingTime(post.body ?? "");
const updatedAt = effectiveUpdatedAt(
  post.data.publishedAt,
  post.data.updatedAt,
  post.filePath ? gitLastModified(post.filePath) : undefined,
);
const toc = headings.filter((h) => h.depth >= 2 && h.depth <= 3);
const showToc = toc.length >= 3;
const { hero, ogImage } = post.data;
// Social image: bespoke ogImage, else the card generated at /og/<slug>.png (see src/pages/og/).
// ogImage.src is already base-prefixed, so absolutize it directly — absoluteUrl()/href() would
// prefix the base a second time. The /og/ path is root-relative; BaseLayout absolutizes it.
const image = ogImage ? new URL(ogImage.src, Astro.site).toString() : `/og/${postSlug(post)}.png`;
---

<BaseLayout
  meta={{
    title: post.data.title,
    description: post.data.description,
    path,
    type: "article",
    image,
    imageAlt: ogImage
      ? post.data.title
      : `${post.data.title} — ${ctx?.series.title ?? "Always Shippable"}`,
    imageWidth: ogImage?.width,
    imageHeight: ogImage?.height,
    tags: post.data.tags.map((t) => tagRegistry[t].label),
    section: ctx?.series.title,
    publishedAt: post.data.publishedAt,
    updatedAt,
    noindex: post.data.draft,
    jsonLd: [
      articleJsonLd(post, path, Astro.site!, {
        image,
        section: ctx?.series.title,
        wordCount: wordCount(post.body ?? ""),
        updatedAt,
      }),
    ],
  }}
>
  <article class="max-w-wide mx-auto">
    <header class="mx-auto max-w-prose">
      {
        ctx && (
          <p class="text-primary eyebrow mb-3">
            <a href={href(seriesPath(ctx.series.id))} class="no-underline hover:underline">
              {ctx.series.title}
            </a>
            {` · Part ${ctx.index} of ${ctx.total}`}
          </p>
        )
      }
      <h1 class="text-display font-semibold">
        {post.data.title}
        {post.data.draft && <DraftBadge />}
      </h1>
      <p class="text-muted-foreground mt-4 text-lg leading-relaxed">{post.data.description}</p>
      <div class="text-muted-foreground mt-4 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm">
        <time datetime={isoDate(post.data.publishedAt)}>
          {formatDate(post.data.publishedAt, "long")}
        </time>
        {
          updatedAt && (
            <span>
              Updated <time datetime={isoDate(updatedAt)}>{formatDate(updatedAt, "long")}</time>
            </span>
          )
        }
        <span>{minutes} min read</span>
        <TagList tags={post.data.tags} />
      </div>
      {
        post.data.draft && (
          <p class="border-destructive text-destructive mt-6 border-l-4 pl-3 text-sm font-medium">
            Draft — visible in development only. It will not be built, listed, or indexed.
          </p>
        )
      }
    </header>

    <figure class="mt-10">
      <Image
        src={hero.src}
        alt={hero.alt}
        widths={[640, 960, 1280]}
        sizes="(min-width: 56rem) 56rem, 100vw"
        loading="eager"
        fetchpriority="high"
        class="w-full rounded-md border"
      />
    </figure>

    <div class="relative">
      {showToc && <PostToc headings={toc} />}
      <div class="mx-auto mt-10 max-w-prose">
        {
          showToc && (
            <details
              open
              class="bg-muted/50 mb-8 rounded-md border px-4 py-3 text-sm lg:hidden print:hidden"
            >
              <summary class="cursor-pointer font-medium">On this page</summary>
              <nav aria-label="On this page" class="mt-2">
                <ul class="space-y-1">
                  {toc.map((h) => (
                    <li class:list={[h.depth === 3 && "pl-4"]}>
                      <a href={`#${h.slug}`} class="text-muted-foreground hover:text-foreground">
                        {h.text}
                      </a>
                    </li>
                  ))}
                </ul>
              </nav>
            </details>
          )
        }

        <div class="prose dark:prose-invert">
          <Content components={{ table: TableWrapper }} />
        </div>

        <footer class="mt-14 border-t pt-8 print:hidden">
          {
            ctx && (
              <nav
                aria-label="Series navigation"
                class="bg-card mb-8 overflow-hidden rounded-xl border"
              >
                <div class="border-b p-5">
                  <a
                    href={href(seriesPath(ctx.series.id))}
                    class="font-semibold no-underline hover:underline"
                  >
                    {ctx.series.title}
                  </a>
                  <div class="mt-3 flex items-center gap-3 text-sm">
                    <span class="text-muted-foreground shrink-0">
                      Part {ctx.index} of {ctx.total}
                    </span>
                    <div
                      role="progressbar"
                      aria-label="Series progress"
                      aria-valuemin="0"
                      aria-valuemax={ctx.total}
                      aria-valuenow={ctx.index}
                      class="bg-muted h-1.5 w-full rounded-full"
                    >
                      <div
                        class="bg-primary h-full rounded-full"
                        style={`width:${(ctx.index / ctx.total) * 100}%`}
                      />
                    </div>
                  </div>
                </div>
                <div class="p-5">
                  {ctx.next ? (
                    <PostTeaser post={ctx.next} label="Up next" />
                  ) : (
                    <p class="text-muted-foreground text-sm">
                      You've reached the end of this series.
                    </p>
                  )}
                  {ctx.prev && (
                    <p class="text-muted-foreground mt-4 text-sm">
                      <a href={href(postPath(ctx.prev))}>
                        ← Part {ctx.index - 1}: {ctx.prev.data.title}
                      </a>
                    </p>
                  )}
                  <p class="mt-4 text-sm">
                    <a href={href(seriesPath(ctx.series.id))}>All posts in this series</a>
                  </p>
                </div>
              </nav>
            )
          }
          {
            related && (
              <aside aria-label="Related post" class="bg-card mb-8 rounded-xl border p-5">
                <PostTeaser post={related} label="You might also like" />
              </aside>
            )
          }
          <p class="text-sm"><a href={href("/all-posts/")}>← All posts</a></p>
        </footer>
      </div>
    </div>
  </article>

  <!-- Figure lightbox (Figure.astro `zoom`): open on button click, any click inside closes. Inline
       to keep prose pages at zero external scripts (e2e/budget.spec.ts). -->
  <script is:inline>
    document.addEventListener("click", (e) => {
      const openBtn = e.target.closest(".figure-zoom");
      if (openBtn) {
        const dialog = openBtn.parentElement.querySelector("dialog.figure-dialog");
        if (dialog) dialog.showModal();
        return;
      }
      const dialog = e.target.closest("dialog.figure-dialog");
      if (dialog) dialog.close();
    });
  </script>
</BaseLayout>

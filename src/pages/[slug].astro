---
import { render } from "astro:content";
// KaTeX styles only on article pages (math never appears elsewhere).
import "katex/dist/katex.min.css";
import { Image } from "astro:assets";
import BaseLayout from "@/layouts/BaseLayout.astro";
import DraftBadge from "@/components/DraftBadge.astro";
import TableWrapper from "@/components/blog/TableWrapper.astro";
import { tags as tagRegistry } from "@/config/tags";
import { getPosts, getSeriesContext, postPath, postSlug, seriesPath } from "@/lib/posts";
import { readingTime } from "@/lib/reading-time";
import { articleJsonLd } from "@/lib/seo";
import { href } from "@/lib/url";
import { formatDate, isoDate } from "@/lib/dates";

export async function getStaticPaths() {
  // getPosts() excludes drafts in production, so draft pages are never generated.
  return (await getPosts()).map((post) => ({ params: { slug: postSlug(post) }, props: { post } }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const path = postPath(post);
const ctx = await getSeriesContext(post);
const minutes = readingTime(post.body ?? "");
const toc = headings.filter((h) => h.depth >= 2 && h.depth <= 3);
const showToc = toc.length >= 3;
const { hero, ogImage } = post.data;
const image = ogImage?.src ?? hero?.src.src;
---

<BaseLayout
  meta={{
    title: post.data.title,
    description: post.data.description,
    path,
    type: "article",
    image,
    publishedAt: post.data.publishedAt,
    updatedAt: post.data.updatedAt,
    noindex: post.data.draft,
    jsonLd: [articleJsonLd(post, path, Astro.site!, image)],
  }}
>
  <article class="max-w-wide mx-auto">
    <header class="mx-auto max-w-prose">
      {
        ctx && (
          <p class="text-primary mb-3 text-xs font-medium tracking-wide uppercase">
            <a href={href(seriesPath(ctx.series.id))} class="no-underline hover:underline">
              {ctx.series.title}
            </a>
            {` · Part ${ctx.index} of ${ctx.total}`}
          </p>
        )
      }
      <h1 class="text-display font-semibold">
        {post.data.title}
        {post.data.draft && <DraftBadge />}
      </h1>
      <p class="text-muted-foreground mt-4 text-lg leading-relaxed">{post.data.description}</p>
      <p class="text-muted-foreground mt-4 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm">
        <time datetime={isoDate(post.data.publishedAt)}>
          {formatDate(post.data.publishedAt, "long")}
        </time>
        {
          post.data.updatedAt && (
            <span>
              Updated{" "}
              <time datetime={isoDate(post.data.updatedAt)}>
                {formatDate(post.data.updatedAt, "long")}
              </time>
            </span>
          )
        }
        <span>{minutes} min read</span>
      </p>
      {
        post.data.tags.length > 0 && (
          <ul class="mt-3 flex flex-wrap gap-1.5 text-xs" aria-label="Tags">
            {post.data.tags.map((t) => (
              <li>
                <a
                  href={href(`/archive/?tag=${t}`)}
                  class="bg-muted hover:bg-accent rounded-sm px-1.5 py-0.5 no-underline"
                >
                  {tagRegistry[t].label}
                </a>
              </li>
            ))}
          </ul>
        )
      }
      {
        post.data.draft && (
          <p class="border-destructive text-destructive mt-6 border-l-4 pl-3 text-sm font-medium">
            Draft — visible in development only. It will not be built, listed, or indexed.
          </p>
        )
      }
    </header>

    {
      hero && (
        <figure class="mt-10">
          <Image
            src={hero.src}
            alt={hero.alt}
            widths={[640, 960, 1280]}
            sizes="(min-width: 56rem) 56rem, 100vw"
            loading="eager"
            fetchpriority="high"
            class="rounded-md border"
          />
        </figure>
      )
    }

    <div class="mx-auto mt-10 max-w-prose">
      {
        showToc && (
          <details open class="bg-muted/50 mb-8 rounded-md border px-4 py-3 text-sm">
            <summary class="cursor-pointer font-medium">On this page</summary>
            <nav aria-label="On this page" class="mt-2">
              <ul class="space-y-1">
                {toc.map((h) => (
                  <li class:list={[h.depth === 3 && "pl-4"]}>
                    <a href={`#${h.slug}`} class="text-muted-foreground hover:text-foreground">
                      {h.text}
                    </a>
                  </li>
                ))}
              </ul>
            </nav>
          </details>
        )
      }

      <div class="prose dark:prose-invert">
        <Content components={{ table: TableWrapper }} />
      </div>

      <footer class="mt-14 border-t pt-8">
        {
          ctx && (
            <nav aria-label="Series navigation" class="mb-8">
              <p class="text-muted-foreground mb-3 text-xs font-medium tracking-wide uppercase">
                {ctx.series.title} · Part {ctx.index} of {ctx.total}
              </p>
              <ul class="grid gap-4 sm:grid-cols-2">
                <li>
                  {ctx.prev ? (
                    <a href={href(postPath(ctx.prev))} class="block no-underline">
                      <span class="text-muted-foreground block text-xs">
                        ← Previous · Part {ctx.index - 1}
                      </span>
                      <span class="hover:text-primary font-medium">{ctx.prev.data.title}</span>
                    </a>
                  ) : (
                    <span class="text-muted-foreground block text-xs">Start of series</span>
                  )}
                </li>
                <li class="sm:text-right">
                  {ctx.next ? (
                    <a href={href(postPath(ctx.next))} class="block no-underline">
                      <span class="text-muted-foreground block text-xs">
                        Next · Part {ctx.index + 1} →
                      </span>
                      <span class="hover:text-primary font-medium">{ctx.next.data.title}</span>
                    </a>
                  ) : (
                    <span class="text-muted-foreground block text-xs">End of series</span>
                  )}
                </li>
              </ul>
              <p class="mt-4 text-sm">
                <a href={href(seriesPath(ctx.series.id))}>All posts in this series</a>
              </p>
            </nav>
          )
        }
        <p class="text-sm"><a href={href("/archive/")}>← Archive</a></p>
      </footer>
    </div>
  </article>
</BaseLayout>

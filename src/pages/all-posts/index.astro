---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ArchiveExplorer from "@/components/archive/ArchiveExplorer";
import { series as seriesRegistry, SERIES_IDS } from "@/config/series";
import { tags as tagRegistry, TAG_IDS } from "@/config/tags";
import { getPosts } from "@/lib/posts";
import { toSearchDocMeta } from "@/lib/search-index";
import { href } from "@/lib/url";

// Metadata only goes to the island as props; headings/body load lazily from /search-index.json.
const posts = await getPosts();
const docs = await Promise.all(posts.map(toSearchDocMeta));
// Only tags some post uses, alphabetical — the registry may hold many more than are in play.
const usedTags = new Set(docs.flatMap((d) => d.tags.map((t) => t.id)));
const tags = TAG_IDS.filter((id) => usedTags.has(id))
  .map((id) => ({ id, label: tagRegistry[id].label }))
  .sort((a, b) => a.label.localeCompare(b.label));
const series = SERIES_IDS.map((id) => ({ id, title: seriesRegistry[id].title }));
---

<BaseLayout
  meta={{
    title: "All Posts",
    description:
      "Every post on Always Shippable — search the full text, filter by tag or series, sort.",
    path: "/all-posts/",
  }}
>
  <div class="max-w-wide mx-auto">
    <h1 class="text-display font-semibold">All Posts</h1>
    <div class="mt-8">
      <ArchiveExplorer
        client:load
        docs={docs}
        tags={tags}
        series={series}
        indexUrl={href("/search-index.json")}
      />
    </div>
  </div>
</BaseLayout>

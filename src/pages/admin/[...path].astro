---
/**
 * Local-development-only admin for the typed config registries. In production getStaticPaths
 * returns no paths, so nothing under /admin/ is ever emitted to dist/ (e2e + check-dist assert
 * this). Writes go through the dev-only Vite middleware in src/dev/admin-plugin.ts.
 * The route stays a rest param so the empty-getStaticPaths guard applies.
 */
import BaseLayout from "@/layouts/BaseLayout.astro";
import AdminApp from "@/components/admin/AdminApp";
import { site } from "@/config/site";
import { author } from "@/config/author";
import { series } from "@/config/series";
import { tags } from "@/config/tags";
import { getPosts, postSlug } from "@/lib/posts";
import { isoDate } from "@/lib/dates";

export function getStaticPaths() {
  return import.meta.env.DEV ? [{ params: { path: undefined } }] : [];
}

const posts = (await getPosts()).map((p) => ({
  slug: postSlug(p),
  title: p.data.title,
  draft: p.data.draft,
  date: isoDate(p.data.publishedAt),
}));
---

<BaseLayout
  meta={{
    title: "Admin (dev only)",
    description: "Local admin for site configuration.",
    path: "/admin/",
    noindex: true,
  }}
>
  <div class="max-w-wide mx-auto">
    <p class="text-destructive eyebrow">Development only</p>
    <h1 class="text-display mt-2 font-semibold">Admin</h1>
    <p class="text-muted-foreground mt-3">
      Edits <code>src/config/*.ts</code> and post <code>draft</code> frontmatter directly and immediately
      (no undo — use git). This route does not exist in the production build.
    </p>
    <div class="mt-8">
      <AdminApp
        client:load
        site={site}
        author={author}
        series={series}
        tags={tags}
        posts={posts}
        endpoint="/__admin"
      />
    </div>
  </div>
</BaseLayout>

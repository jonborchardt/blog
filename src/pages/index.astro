---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PostList from "@/components/PostList.astro";
import PostCard from "@/components/PostCard.astro";
import { site } from "@/config/site";
import { getFeaturedPost, getPosts } from "@/lib/posts";
import { personJsonLd } from "@/lib/seo";
import { href } from "@/lib/url";

const featured = await getFeaturedPost();
const recent = (await getPosts()).filter((p) => p.id !== featured?.id).slice(0, 6);
---

<BaseLayout
  meta={{
    title: site.name,
    description: site.description,
    path: "/",
    jsonLd: [personJsonLd(Astro.site!)],
  }}
>
  <div class="max-w-wide mx-auto">
    <header class="max-w-prose">
      <h1 class="text-display font-semibold">{site.name}</h1>
      <p class="text-muted-foreground mt-4 text-lg leading-relaxed">{site.description}</p>
    </header>

    {
      featured && (
        <section class="mt-14 border-t pt-8" aria-labelledby="featured">
          <h2
            id="featured"
            class="text-muted-foreground mb-5 text-xs font-medium tracking-wide uppercase"
          >
            Featured
          </h2>
          <PostCard post={featured} />
        </section>
      )
    }

    <section class="mt-14 border-t pt-8" aria-labelledby="recent">
      <div class="mb-5 flex items-baseline justify-between gap-4">
        <h2 id="recent" class="text-muted-foreground text-xs font-medium tracking-wide uppercase">
          Recent
        </h2>
        <a href={href("/archive/")} class="text-sm">All posts →</a>
      </div>
      {
        recent.length ? (
          <PostList posts={recent} heading="h3" />
        ) : (
          <p class="text-muted-foreground">No other posts yet.</p>
        )
      }
    </section>
  </div>
</BaseLayout>

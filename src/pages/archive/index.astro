---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PostList from "@/components/PostList.astro";
import { getPosts } from "@/lib/posts";

// ponytail: static list for now. Client-side search/filter/sort (URL-query-driven React island)
// is planned; the data it needs is exactly `posts` below, serialized as props.
const posts = await getPosts();
---

<BaseLayout meta={{ title: "Archive", description: "All posts.", path: "/archive/" }}>
  <div class="max-w-wide mx-auto">
    <h1 class="text-display font-semibold">Archive</h1>
    <p class="text-muted-foreground mt-3">
      {posts.length}
      {posts.length === 1 ? "post" : "posts"}
    </p>
    <div class="mt-10 border-t pt-8"><PostList posts={posts} /></div>
  </div>
</BaseLayout>

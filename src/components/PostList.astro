---
import { Image } from "astro:assets";
import type { Post } from "@/lib/posts";
import { postPath, seriesPath } from "@/lib/posts";
import { series as seriesRegistry } from "@/config/series";
import { href } from "@/lib/url";
import { formatDate, isoDate } from "@/lib/dates";
import { readingTime } from "@/lib/reading-time";
import DraftBadge from "@/components/DraftBadge.astro";
import TagList from "@/components/TagList.astro";

interface Props {
  posts: Post[];
  /** Heading level for post titles; keep the page's heading hierarchy in order. */
  heading?: "h2" | "h3";
}
const { posts, heading: Heading = "h2" } = Astro.props;
---

<ul class="divide-y">
  {
    posts.map((post) => (
      <li class="grid-cols-thumb grid gap-x-4 py-5 first:pt-0 last:pb-0">
        <a href={href(postPath(post))} tabindex="-1" aria-hidden="true">
          <Image
            src={post.data.hero.src}
            alt={post.data.hero.alt}
            width={540}
            height={216}
            class="aspect-card w-full rounded-md border object-cover"
          />
        </a>
        <div>
          {post.data.series && (
            <p class="text-primary eyebrow mb-1">
              <a href={href(seriesPath(post.data.series))} class="no-underline hover:underline">
                {seriesRegistry[post.data.series].title}
              </a>
              {post.data.seriesOrder && ` · Part ${post.data.seriesOrder}`}
            </p>
          )}
          <Heading class="text-title font-semibold">
            <a href={href(postPath(post))} class="hover:text-primary no-underline">
              {post.data.title}
            </a>
            {post.data.draft && <DraftBadge />}
          </Heading>
          <p class="text-muted-foreground mt-1">{post.data.description}</p>
          <div class="text-muted-foreground mt-2 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm">
            <time datetime={isoDate(post.data.publishedAt)}>
              {formatDate(post.data.publishedAt)}
            </time>
            <span>{readingTime(post.body ?? "")} min read</span>
            <TagList tags={post.data.tags} />
          </div>
        </div>
      </li>
    ))
  }
</ul>

---
import { author } from "@/config/author";
import { site } from "@/config/site";
import { href } from "@/lib/url";
---

<footer class="border-t">
  <div
    class="text-muted-foreground max-w-page mx-auto flex flex-wrap items-center justify-between gap-x-6 gap-y-3 px-4 py-8 text-sm sm:px-6"
  >
    <p>
      <span class="text-foreground font-medium">{author.name}</span>
      <span aria-hidden="true"> · </span>
      <span>{author.tagline}</span>
    </p>
    <ul class="flex flex-wrap gap-x-4 gap-y-2">
      <li><a href={author.links.github} rel="me" class="hover:text-foreground">GitHub</a></li>
      <li><a href={author.links.linkedin} rel="me" class="hover:text-foreground">LinkedIn</a></li>
      <li><a href={href("/rss.xml")} class="hover:text-foreground">RSS</a></li>
    </ul>
    <p class="basis-full text-xs">© {new Date().getFullYear()} {author.name} · {site.name}</p>
  </div>
</footer>

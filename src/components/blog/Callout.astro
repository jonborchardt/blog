---
/**
 * Callout — a highlighted aside for notes, tips and warnings. Static, no JS.
 *
 * Props: `variant` = "note" | "tip" | "warning" | "danger" | "info" (default "note"); `title?`.
 *
 * ```mdx
 * import Callout from "@/components/blog/Callout.astro";
 *
 * <Callout variant="tip" title="Shortcut">Body text, Markdown allowed.</Callout>
 * ```
 */
type Variant = "note" | "tip" | "warning" | "danger" | "info";
interface Props {
  variant?: Variant;
  title?: string;
}
const { variant = "note", title } = Astro.props;

const labels: Record<Variant, string> = {
  note: "Note",
  tip: "Tip",
  warning: "Warning",
  danger: "Danger",
  info: "Info",
};
const tone: Record<Variant, string> = {
  note: "border-l-muted-foreground",
  tip: "border-l-primary",
  warning: "border-l-amber-600 dark:border-l-amber-400",
  danger: "border-l-destructive",
  info: "border-l-primary",
};
---

<aside
  role="note"
  aria-label={title ?? labels[variant]}
  class:list={["not-prose bg-muted/60 my-6 rounded-md border border-l-4 px-4 py-3", tone[variant]]}
>
  <p class="mb-1 flex items-center gap-2 text-sm font-semibold">
    <svg
      class="h-4 w-4 shrink-0"
      aria-hidden="true"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      {
        variant === "tip" ? (
          <path d="M9 18h6M10 22h4M12 2a7 7 0 0 0-4 12.7V17h8v-2.3A7 7 0 0 0 12 2z" />
        ) : variant === "warning" || variant === "danger" ? (
          <path d="M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0zM12 9v4M12 17h.01" />
        ) : (
          <>
            <circle cx="12" cy="12" r="10" />
            <path d="M12 16v-4M12 8h.01" />
          </>
        )
      }
    </svg>
    <span>{title ?? labels[variant]}</span>
  </p>
  <div class="text-sm leading-relaxed [&_a]:underline [&_code]:font-mono [&_p+p]:mt-2">
    <slot />
  </div>
</aside>

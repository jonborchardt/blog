---
/**
 * Figure — wraps an image/SVG/anything with an optional caption and a width.
 *
 * Props: `caption?` (rendered as <figcaption>), `width` = "prose" | "wide" | "full" (default
 * "prose"), `zoom?` (default false) — wraps the content in a button that opens a full-size
 * <dialog> lightbox. Use `zoom` ONLY when the direct child is a plain <img> (sweep comparisons,
 * screenshots); never around VizFigure (its ids would duplicate) or interactive islands.
 * "wide"/"full" break out of the prose measure on ≥lg screens; on narrow screens nothing breaks out.
 *
 * ```mdx
 * import Figure from "@/components/blog/Figure.astro";
 *
 * <Figure caption="Original versus upscale." zoom>
 *   <img src={sweep.src} width="1920" height="1140" alt="Sweep comparison…" />
 * </Figure>
 * ```
 */
interface Props {
  caption?: string;
  width?: "prose" | "wide" | "full";
  zoom?: boolean;
}
const { caption, width = "prose", zoom = false } = Astro.props;
const zoomHtml = zoom ? await Astro.slots.render("default") : "";
---

<figure class:list={["figure my-8", `figure-${width}`]}>
  {
    zoom ? (
      <>
        <button
          type="button"
          class="figure-zoom"
          aria-haspopup="dialog"
          aria-label={`Zoom: ${caption ?? "image"}`}
          set:html={zoomHtml}
        />
        <dialog class="figure-dialog" aria-label={caption ?? "Enlarged image"}>
          <button type="button" class="figure-dialog-close" aria-label="Close">
            &times;
          </button>
          <div set:html={zoomHtml} />
        </dialog>
      </>
    ) : (
      <slot />
    )
  }
  {
    caption && (
      <figcaption class="text-muted-foreground mt-3 text-center text-sm">{caption}</figcaption>
    )
  }
</figure>

<style is:global>
  .figure > :not(figcaption),
  .figure-zoom > * {
    margin: 0 auto;
  }
  .figure > img,
  .figure > picture,
  .figure > svg,
  .figure > video,
  .figure-zoom img,
  .figure-zoom svg {
    display: block;
    max-width: 100%;
    height: auto;
    border-radius: var(--radius-md);
  }
  @media (min-width: 64rem) {
    /* Break out symmetrically past the prose measure (42rem) up to wide (56rem) / page (72rem). */
    .figure-wide {
      width: min(var(--container-wide), calc(100vw - 3rem));
      margin-inline: calc((var(--container-prose) - min(var(--container-wide), 100vw - 3rem)) / 2);
    }
    .figure-full {
      width: min(var(--container-page), calc(100vw - 3rem));
      margin-inline: calc((var(--container-prose) - min(var(--container-page), 100vw - 3rem)) / 2);
    }
  }
</style>

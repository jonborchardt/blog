---
import { site } from "@/config/site";
import { href } from "@/lib/url";
import ThemeToggle from "@/components/ThemeToggle.astro";
// Inlined SVG (no extra request; theme-independent colours).
import logo from "@/assets/logo.svg?raw";

const current = Astro.url.pathname;
const isActive = (path: string) => current.startsWith(href(path));
---

<header class="border-b print:hidden">
  <div
    class="max-w-page mx-auto flex flex-wrap items-center justify-between gap-x-6 gap-y-2 px-4 py-3 sm:px-6"
  >
    <a href={href("/")} class="flex items-center gap-2 font-semibold tracking-tight no-underline">
      <span
        class="[&>svg]:text-foreground inline-block h-8 w-8 [&>svg]:h-full [&>svg]:w-full"
        aria-hidden="true"
        set:html={logo}
      />
      <span>{site.name}</span>
    </a>
    <nav aria-label="Main">
      <ul class="flex items-center gap-1 text-sm">
        {
          site.nav.map((item) => (
            <li>
              <a
                href={href(item.href)}
                aria-current={isActive(item.href) ? "page" : undefined}
                class="text-muted-foreground hover:text-foreground aria-[current=page]:text-foreground rounded-sm px-2 py-1 no-underline aria-[current=page]:font-medium"
              >
                {item.label}
              </a>
            </li>
          ))
        }
        <li class="ml-2"><ThemeToggle /></li>
      </ul>
    </nav>
  </div>
</header>

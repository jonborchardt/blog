---
/** Featured-post card for the homepage: title, description, date, series/tags, hero. */
import { Image } from "astro:assets";
import type { Post } from "@/lib/posts";
import { postPath } from "@/lib/posts";
import { series as seriesRegistry } from "@/config/series";
import { tags as tagRegistry } from "@/config/tags";
import { href } from "@/lib/url";
import { formatDate, isoDate } from "@/lib/dates";
import { readingTime } from "@/lib/reading-time";
import DraftBadge from "@/components/DraftBadge.astro";

interface Props {
  post: Post;
}
const { post } = Astro.props;
const { hero, series, seriesOrder, tags, title, description, publishedAt, draft } = post.data;
---

<article class="grid gap-6 md:grid-cols-5 md:items-center">
  <a href={href(postPath(post))} class="md:col-span-2" tabindex="-1" aria-hidden="true">
    <Image
      src={hero.src}
      alt={hero.alt}
      widths={[480, 800]}
      sizes="(min-width: 48rem) 24rem, 100vw"
      loading="eager"
      class="rounded-md border"
    />
  </a>
  <div class="md:col-span-3">
    {
      series && (
        <p class="text-primary mb-2 text-xs font-medium tracking-wide uppercase">
          {seriesRegistry[series].title}
          {seriesOrder && ` · Part ${seriesOrder}`}
        </p>
      )
    }
    <h3 class="text-2xl leading-tight font-semibold tracking-tight md:text-3xl">
      <a href={href(postPath(post))} class="hover:text-primary no-underline">{title}</a>
      {draft && <DraftBadge />}
    </h3>
    <p class="text-muted-foreground mt-3 text-lg">{description}</p>
    <p class="text-muted-foreground mt-4 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm">
      <time datetime={isoDate(publishedAt)}>{formatDate(publishedAt)}</time>
      <span>{readingTime(post.body ?? "")} min read</span>
      {
        tags.length > 0 && (
          <span class="flex flex-wrap gap-1.5" aria-label="Tags">
            {tags.map((t) => (
              <span class="bg-muted rounded-sm px-1.5 py-0.5 text-xs">{tagRegistry[t].label}</span>
            ))}
          </span>
        )
      }
    </p>
  </div>
</article>

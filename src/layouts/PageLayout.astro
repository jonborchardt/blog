---
/** Layout for MDX pages (e.g. /resume/). Frontmatter supplies title/description/path. */
import BaseLayout from "@/layouts/BaseLayout.astro";
import { personJsonLd } from "@/lib/seo";

interface Props {
  frontmatter: { title: string; description: string; path: string };
}
const { frontmatter } = Astro.props;
---

<BaseLayout meta={{ ...frontmatter, jsonLd: [personJsonLd(Astro.site!)] }}>
  <div class="mx-auto max-w-prose">
    <div class="prose dark:prose-invert">
      <slot />
    </div>
  </div>
</BaseLayout>

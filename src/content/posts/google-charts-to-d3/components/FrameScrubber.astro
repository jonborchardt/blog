---
/**
 * FrameScrubber — candidate presentation for "the sweep": the captured frames from
 * the screenshot sequence, stepped through with previous/next buttons.
 * No dependencies; degrades to showing the first frame.
 */
interface Props {
  frames: { src: string; alt: string; label: string }[];
}
const { frames } = Astro.props;
const first = frames[0] ?? { src: "", alt: "", label: "" };
---

<figure class="figure figure-wide frame-scrub my-8">
  <div class="frame-scrub-stage">
    {
      frames.map((f, i) => (
        <img
          src={f.src}
          alt={f.alt}
          width="1400"
          height="906"
          loading="lazy"
          data-fs-frame={i}
          data-label={f.label}
          class:list={[i !== 0 && "fs-hidden"]}
        />
      ))
    }
  </div>
  <div class="frame-scrub-nav">
    <button type="button" data-fs-prev disabled>&larr; Previous</button>
    <span data-fs-pos aria-live="polite">1 / {frames.length}</span>
    <button type="button" data-fs-next>Next &rarr;</button>
  </div>
  <figcaption class="text-muted-foreground mt-3 text-center text-sm">
    Step through the drag, frame by frame.{" "}
    <span data-fs-label>{first.label}</span>
  </figcaption>
</figure>

<style>
  .fs-hidden {
    display: none;
  }
  .frame-scrub-nav {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 1rem;
    margin-top: 0.5rem;
    font-size: var(--text-sm);
    color: var(--color-muted-foreground);
  }
  .frame-scrub-nav button {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 0.25rem 0.875rem;
    min-height: 24px;
    cursor: pointer;
  }
  .frame-scrub-nav button:hover:not(:disabled) {
    background: var(--color-accent);
  }
  .frame-scrub-nav button:disabled {
    opacity: 0.4;
    cursor: default;
  }
</style>

<script>
  for (const root of document.querySelectorAll(".frame-scrub")) {
    const frames = [...root.querySelectorAll("[data-fs-frame]")];
    const prev = root.querySelector("[data-fs-prev]") as HTMLButtonElement | null;
    const next = root.querySelector("[data-fs-next]") as HTMLButtonElement | null;
    const pos = root.querySelector("[data-fs-pos]");
    const label = root.querySelector("[data-fs-label]");
    let i = 0;
    const show = (n: number) => {
      i = Math.max(0, Math.min(frames.length - 1, n));
      frames.forEach((f, j) => f.classList.toggle("fs-hidden", j !== i));
      if (pos) pos.textContent = `${i + 1} / ${frames.length}`;
      if (label) label.textContent = frames[i]?.getAttribute("data-label") ?? "";
      if (prev) prev.disabled = i === 0;
      if (next) next.disabled = i === frames.length - 1;
    };
    prev?.addEventListener("click", () => show(i - 1));
    next?.addEventListener("click", () => show(i + 1));
  }
</script>

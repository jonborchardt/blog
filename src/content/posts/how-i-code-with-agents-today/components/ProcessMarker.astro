---
/**
 * ProcessMarker — "you are here" rail for this post's pipeline.
 * `step` is 1-based. Step 1 is the TL;DR map (no rule, no top space); later steps sit above their section.
 */
interface Props {
  step: number;
}
const { step } = Astro.props;
const stages = [
  "idea",
  "reason about product + architecture",
  "bootstrap prompt",
  "working repository scaffold",
  "repository becomes source of truth",
  "repository-aware implementation plan",
  "plan review / steering",
  "agent execution",
  "report review / steering",
  "validate the resulting system",
  "extend it in short sessions",
];
const n = stages.length;
const label = `Process stage ${step} of ${n}: ${stages[step - 1]}`;
---

<ol
  class:list={[
    "process-timeline mb-0 list-none p-0 text-sm",
    step > 1 && "border-border mt-12 border-t pt-3",
  ]}
  aria-label={label}
>
  {
    stages.map((name, i) => (
      <li
        class:list={[
          "relative pl-6",
          i + 1 === step ? "text-foreground font-semibold" : "text-muted-foreground",
        ]}
        aria-current={i + 1 === step ? "step" : undefined}
      >
        {name}
      </li>
    ))
  }
</ol>

<style>
  .process-timeline + :global(h2) {
    margin-top: 0.5rem;
  }
  .process-timeline li {
    margin: 0;
    line-height: 1.25;
  }
  .process-timeline li::before {
    content: "";
    position: absolute;
    left: 0.25rem;
    top: 0.35rem;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 9999px;
    border: 1px solid var(--primary);
    background: var(--background);
  }
  .process-timeline li[aria-current]::before {
    background: var(--primary);
  }
  .process-timeline li:not(:last-child)::after {
    content: "";
    position: absolute;
    left: 0.5rem;
    top: 0.85rem;
    bottom: -0.35rem;
    border-left: 1px solid var(--border);
  }
</style>

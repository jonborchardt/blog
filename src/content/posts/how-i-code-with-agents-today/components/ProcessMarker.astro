---
/**
 * ProcessMarker — "you are here" rail for this post's pipeline.
 * Three beats, eleven stages. `step` is 1-based across all stages.
 * Step 1 is the TL;DR map (no rule, no top space); later steps sit above their section.
 */
interface Props {
  step: number;
}
const { step } = Astro.props;
const beats = [
  {
    title: "Decide before you prompt",
    stages: ["idea", "reason about product + architecture", "bootstrap prompt"],
  },
  {
    title: "The repository replaces the prompt",
    stages: [
      "working repository scaffold",
      "repository becomes source of truth",
      "repository-aware implementation plan",
      "plan review / steering",
    ],
  },
  {
    title: "Validation is the real output",
    stages: [
      "agent execution",
      "report review / steering",
      "validate the resulting system",
      "extend it in short sessions",
    ],
  },
];
const stages = beats.flatMap((b) => b.stages);
const n = stages.length;
const label = `Process stage ${step} of ${n}: ${stages[step - 1]}`;
let offset = 0;
const groups = beats.map((b, bi) => {
  const start = offset;
  offset += b.stages.length;
  return { ...b, start, active: step > start && step <= offset, last: bi === beats.length - 1 };
});
---

<ol
  class:list={[
    "process-timeline mb-0 list-none p-0 text-sm",
    step > 1 && "border-border mt-12 border-t pt-3",
  ]}
  aria-label={label}
>
  {
    groups.map((g) => (
      <li class:list={["beat", g.active ? "text-foreground" : "text-muted-foreground"]}>
        <span class="eyebrow block">{g.title}</span>
        <ol class="stages mb-0 list-none p-0">
          {g.stages.map((name, i) => {
            const s = g.start + i + 1;
            return (
              <li
                class:list={[
                  "relative pl-6",
                  s === step ? "text-foreground font-semibold" : "text-muted-foreground",
                ]}
                aria-current={s === step ? "step" : undefined}
              >
                {name}
              </li>
            );
          })}
        </ol>
      </li>
    ))
  }
</ol>

<style>
  .process-timeline + :global(h2) {
    margin-top: 0.5rem;
  }
  .process-timeline li {
    margin: 0;
    line-height: 1.25;
  }
  .process-timeline > .beat {
    margin-top: 0.5rem;
  }
  .process-timeline > .beat:first-child {
    margin-top: 0;
  }
  .stages {
    margin-top: 0.25rem;
  }
  .stages li::before {
    content: "";
    position: absolute;
    left: 0.25rem;
    top: 0.35rem;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 9999px;
    border: 1px solid var(--primary);
    background: var(--background);
  }
  .stages li[aria-current]::before {
    background: var(--primary);
  }
  .stages li:not(:last-child)::after {
    content: "";
    position: absolute;
    left: 0.5rem;
    top: 0.85rem;
    bottom: -0.35rem;
    border-left: 1px solid var(--border);
  }
</style>
